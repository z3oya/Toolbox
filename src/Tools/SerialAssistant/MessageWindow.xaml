<Window x:Class="Toolbox.Tools.SerialAssistant.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20,20,20,16">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,10,0"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="310" FontSize="12"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>
        <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="88"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
