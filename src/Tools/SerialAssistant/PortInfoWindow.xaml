<Window x:Class="Toolbox.Tools.SerialAssistant.PortInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Port Devices" Width="740" Height="460" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" MinWidth="80" Click="Refresh_Click"/>
            <Button Content="Close" MinWidth="80" Margin="8,0,0,0" IsCancel="True"/>
            <Button x:Name="SelectButton" Content="Select" Style="{StaticResource PrimaryButton}"
                    MinWidth="80" Margin="8,0,0,0" IsEnabled="False"
                    IsDefault="True" Click="Select_Click"/>
        </StackPanel>
        <!-- Stacked, full-width lists; column widths are fixed (no splitter, no grippers). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListView x:Name="DevicesList" Grid.Row="0" SelectionMode="Single"
                      SelectionChanged="DevicesList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Port" Width="70" DisplayMemberBinding="{Binding PortName}"/>
                        <GridViewColumn Header="Description" Width="560" DisplayMemberBinding="{Binding Description}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <ListView x:Name="DetailsList" Grid.Row="1" Margin="0,8,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Property" Width="140" DisplayMemberBinding="{Binding Property}"/>
                        <GridViewColumn Header="Value" Width="490" DisplayMemberBinding="{Binding Value}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
