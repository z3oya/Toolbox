<Window x:Class="Toolbox.Tools.SerialAssistant.PortInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Port Devices" Width="740" Height="420" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" MinWidth="80" Click="Refresh_Click"/>
            <Button Content="Close" MinWidth="80" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" MinWidth="90"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="DevicesList" Grid.Column="0" SelectionMode="Single"
                      SelectionChanged="DevicesList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Port" Width="80" DisplayMemberBinding="{Binding PortName}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch"
                          HorizontalAlignment="Center" Background="#E2E2E2"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
            <ListView x:Name="DetailsList" Grid.Column="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Property" Width="140" DisplayMemberBinding="{Binding Property}"/>
                        <GridViewColumn Header="Value" Width="440" DisplayMemberBinding="{Binding Value}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
