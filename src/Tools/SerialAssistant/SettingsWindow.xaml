<Window x:Class="Toolbox.Tools.SerialAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="360" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20,20,20,16">
        <TextBlock Text="Encoding" FontWeight="SemiBold"
                   Foreground="{StaticResource TextTitleBrush}"/>
        <ComboBox x:Name="EncodingBox" MinWidth="140" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,14"/>
        <TextBlock Text="Serial Assistant" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="serial port debug tool (ASCII/HEX, GBK, logging)"
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="Toolbox · .NET 10 WPF · AvalonEdit editor"
                   FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
    </StackPanel>
</Window>
