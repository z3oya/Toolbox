<Window x:Class="Toolbox.Tools.SerialAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Serial Assistant" Width="1000" Height="680" MinWidth="780" MinHeight="520"
        Icon="app.ico"
        Background="{StaticResource WindowBgBrush}">
    <DockPanel>
        <!-- Top config bar: chrome strip; config controls wrap to a second line when the
             window narrows, while Connect stays pinned to the right edge. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                Padding="10,7,10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <TextBlock Text="Port" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PortBox" MinWidth="100"/>
                    <Button x:Name="PortInfoButton" Content="…" Width="40" Margin="2,0,0,0" Click="PortInfo_Click"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
                    <TextBlock Text="Baud" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,6,0"/>
                    <ComboBox x:Name="BaudBox" MinWidth="80" IsEditable="True"/>
                    <ComboBox x:Name="DataBitsBox" MinWidth="46" Margin="8,0,0,0"/>
                    <ComboBox x:Name="StopBitsBox" MinWidth="54" Margin="8,0,0,0"/>
                    <ComboBox x:Name="ParityBox" MinWidth="68" Margin="8,0,0,0"/>
                    <ComboBox x:Name="FlowBox" MinWidth="96" Margin="8,0,0,0"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="ConnectButton" Content="Connect" Style="{StaticResource PrimaryButton}"
                            Width="110" Click="Connect_Click"/>
                    <!-- Connection indicator: gray at rest, green while the port is open. -->
                    <Ellipse x:Name="ConnectedDot" Width="10" Height="10" Margin="8,0,0,0"
                             VerticalAlignment="Center" Fill="{StaticResource SeparatorBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom status bar. The last StatusBarItem fills the remaining width (default
             DockPanel panel, LastChildFill) with its content right-aligned - the WinForms
             Spring+MiddleRight equivalent. -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}"
                   BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}">
            <StatusBarItem>
                <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"/>
            </StatusBarItem>
            <StatusBarItem Content="  |  "/>
            <StatusBarItem>
                <TextBlock x:Name="StatusInfo" Text="Not connected" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCounters" Text="RX 0 B  TX 0 B" VerticalAlignment="Center"/>
                    <Button x:Name="ResetCountersButton" Content="Reset" Margin="12,0,0,0" Click="ResetCounters_Click"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Center "田" quadrants: TL=receive log, TR=receive options, BL=TX editor, BR=send options. -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="170"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ReceiveRow" Height="2*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="SendRow" Height="1*" MinHeight="150"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="5">
                <avalonedit:TextEditor x:Name="LogEditor"
                    IsReadOnly="True" ShowLineNumbers="True" WordWrap="False"
                    FontFamily="Consolas" FontSize="13" Padding="6,4"
                    Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <GroupBox x:Name="ReceiveGroup" Grid.Row="0" Grid.Column="2" Header="Receive">
                <StackPanel>
                    <CheckBox x:Name="RxHexCheck" Content="RX: HEX"/>
                    <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" Margin="0,4,0,0"/>
                    <Button x:Name="ClearButton" Content="Clear" Margin="0,16,0,0"
                            HorizontalAlignment="Left" Click="Clear_Click"/>
                    <Button x:Name="SaveLogButton" Content="Save log…" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Click="SaveLog_Click"/>
                </StackPanel>
            </GroupBox>

            <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{StaticResource SeparatorBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <Border Grid.Row="2" Grid.Column="0" Background="White"
                    BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" CornerRadius="5">
                <avalonedit:TextEditor x:Name="TxEditor"
                    ShowLineNumbers="True" WordWrap="False"
                    FontFamily="Consolas" FontSize="13" Padding="6,4"
                    Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                    PreviewKeyDown="TxEditor_PreviewKeyDown"/>
            </Border>

            <GroupBox x:Name="SendGroup" Grid.Row="2" Grid.Column="2" Header="Send">
                <StackPanel>
                    <Button x:Name="SendButton" Content="Send" Style="{StaticResource PrimaryButton}"
                            Padding="40,10" HorizontalAlignment="Stretch" Click="Send_Click"/>
                    <CheckBox x:Name="TxHexCheck" Content="TX: HEX" Margin="0,8,0,0"/>
                    <Button x:Name="LoadFileButton" Content="Load file…" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Click="LoadFile_Click"/>
                    <TextBlock Text="Line ending" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,2"/>
                    <ComboBox x:Name="EolBox" MinWidth="150" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="{StaticResource SeparatorBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>
        </Grid>
    </DockPanel>
</Window>
