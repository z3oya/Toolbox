<Window x:Class="Toolbox.Tools.SerialAssistant.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20,20,20,16">
        <TextBlock Text="Serial Assistant" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="serial port debug tool (ASCII/HEX, GBK, logging)"
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,12"/>
        <TextBlock Text="Toolbox · .NET 10 WPF · AvalonEdit editor"
                   FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"/>
        <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="88"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
